NVIDIA_API_KEY=nvapi-your-key-here
OPENROUTER_API_KEY=sk-or-your-key-here
CRON_SECRET=your-random-secret-here
# Fine-grained GitHub PAT with contents:write on THIS repo only; lets the cron
# job commit daily snapshots to data/snapshots/. Omit to skip persistence.
SNAPSHOT_GITHUB_TOKEN=github_pat-your-token-here
